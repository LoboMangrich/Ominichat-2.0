# Copie este arquivo para .env e preencha os valores.
# Nenhum valor aqui é real — são apenas formato/descrição.
#
# O servidor sobe sem nenhuma destas variáveis, mas falha rápido na
# inicialização (server/_core/index.ts → assertRequiredEnv) se faltar
# DATABASE_URL ou JWT_SECRET, que são as únicas obrigatórias.

# ── Banco de dados (OBRIGATÓRIO) ──────────────────────────────────────────
# String de conexão MySQL (dialect: "mysql" no drizzle — não é Postgres).
# Sem ela, getDb() retorna null e nenhuma feature que grava/lê do banco
# funciona; drizzle-kit (pnpm db:push) também exige isso.
# Formato: mysql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=

# ── Sessão (OBRIGATÓRIO) ──────────────────────────────────────────────────
# Chave usada para assinar/verificar o cookie de sessão (JWT HS256, jose).
# Mínimo 32 caracteres, aleatória. O servidor recusa iniciar se o valor
# tiver menos de 32 caracteres ou parecer um placeholder (ex.: contém
# "changeme" ou "secret").
# Gere com: openssl rand -base64 32
JWT_SECRET=

# ── Cron / tarefas agendadas (opcional) ───────────────────────────────────
# Segredo enviado no header x-cron-secret pelo scheduler externo nas chamadas
# a /api/scheduled/*. Sem ele, só uma sessão de Admin logada aciona essas rotas
# (fail-closed já implementado em routeGuards.ts — não é obrigatório).
CRON_SECRET=

# ── Bootstrap local (opcional) ────────────────────────────────────────────
# openId que vira Admin automaticamente no primeiro login local, via cookie
# de sessão gerado por scripts/dev-session.ts (pnpm dev:session) — nunca em
# produção. Para o bootstrap do primeiro Admin em produção, use
# scripts/create-admin.ts (pnpm create-admin) — não fica variável aqui de
# propósito: ele recebe ADMIN_NAME/ADMIN_EMAIL/ADMIN_PASSWORD inline na
# invocação, não persistidos em .env (é senha em texto puro).
OWNER_OPEN_ID=

# ── Forge API (Manus) — IA, storage, imagem, voz, notificações (opcional) ──
# Sem essas, cada chamada específica falha em runtime com erro claro
# (ex.: "Storage config missing: set BUILT_IN_FORGE_API_URL...") — o servidor
# continua no ar, só a feature específica não funciona.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── Webhooks — validação de assinatura dos POSTs (opcional, mas recomendado
# antes de qualquer deploy) ────────────────────────────────────────────────
# Sem essas, webhookAuth.ts falha fechado: o POST é rejeitado para o provedor
# correspondente em vez de aceito sem checagem.

# Meta App Secret (Facebook Developers > App Settings > Basic). Valida o
# HMAC-SHA256 do corpo bruto contra o header x-hub-signature-256 nos POSTs
# de WhatsApp e Instagram.
META_APP_SECRET=

# Secret token configurado via setWebhook do Telegram (parâmetro
# secret_token). Valida o header x-telegram-bot-api-secret-token nos POSTs
# do Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Segredo do encaminhador de e-mail em /api/webhooks/email-ticket (ex.: Reclame
# Aqui via forwarder externo — o endpoint não é ligado a um provedor específico,
# ver server/_core/routeGuards.ts). Sem essa variável, a rota nega toda
# requisição (fail-closed) — não fica aberta.
# Aceito por duas vias, qualquer uma que bata libera:
#   1. Header x-email-ticket-secret — PREFERENCIAL. Use sempre que o
#      encaminhador permitir configurar header customizado.
#   2. Token no path, /api/webhooks/email-ticket/{token} — só para
#      encaminhadores que não suportam header customizado. Evite: URLs vazam
#      com mais facilidade que headers (log de acesso do servidor/proxy,
#      ferramentas de APM, histórico de navegador se alguém testar manualmente).
EMAIL_TICKET_SECRET=

# Segredo do webhook de saída da Sara (Epic 72), fornecido pelo time da Sara.
# Valida o header x-sara-signature (HMAC-SHA256 em hex sobre o corpo bruto) em
# POST /api/webhooks/sara. Sem ele, a rota nega toda requisição (fail-closed).
# O mesmo valor precisa ser configurado do lado da Sara junto com a URL.
# Gere com: openssl rand -hex 32
SUPPORT_OUTBOUND_WEBHOOK_SECRET=

# ── Webhooks — handshake GET da Meta (opcional, mas recomendado) ─────────
# Usados só na verificação inicial do webhook (hub.verify_token). Não
# substituem META_APP_SECRET: o handshake GET e a assinatura dos POSTs são
# mecanismos independentes.
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_VERIFY_TOKEN=

# ── Sara Support API (opcional) ───────────────────────────────────────────
# Sistema externo (Epic 71) que expõe conversas de um bot de IA no WhatsApp
# com takeover humano — tela "Sara IA" em /sara. Sem essas, a tela carrega e
# mostra erro claro ao tentar listar/enviar; nenhuma outra feature é afetada.
# URL base da API (sem barra final).
SARA_SUPPORT_API_URL=
# Chave enviada no header x-api-key. Gerada pelo time responsável pela Sara
# Support API (Story 71.1) — não é o usuário/senha que protege o Swagger.
SARA_SUPPORT_API_KEY=

# ── Frontend (build-time via Vite, opcional) ──────────────────────────────
# Lidas em client/src/components/Map.tsx e client/src/const.ts.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Origem pública da aplicação (client/src/lib/publicUrl.ts), usada para montar
# URLs de webhook e links copiáveis que precisam resolver fora desta aba (ex.:
# configuração de webhook em provedor externo, link de formulário enviado a
# terceiro). Sem essa variável, cai em window.location.origin — funciona sem
# configuração em local, preview e produção, desde que a origem servida seja
# a mesma que resolve externamente. Só preencha se a app rodar atrás de proxy
# ou em domínio diferente do que os visitantes externos acessam.
# Formato: URL completa, sem barra final (ex.: https://app.suaempresa.com)
VITE_PUBLIC_BASE_URL=

# ── Servidor (opcional, já tem default no código) ─────────────────────────
PORT=3000
NODE_ENV=development
